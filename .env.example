# Local fixture database only. Docker binds PostgreSQL to loopback.
# If you change the published port, also update DATABASE_URL for host CLI use.
DERAI_DEV_DB_PORT=55432
DATABASE_URL=postgresql+psycopg://derai_worker@127.0.0.1:55432/derai_scheduler_local
PGPASSWORD=derai_local_worker
WORKER_INTERVAL=60
SOCIAL_COLLECTION_ENABLED=true
CONNECTOR_ARTICLE_MAX_PAGES=1

# Only used by the explicitly selected Compose profile `external`.
# Enter the migrated DERAI database address and the existing worker role here.
EXTERNAL_DATABASE_URL=
EXTERNAL_PGPASSWORD=

# The scheduler does not call an LLM. Future scraper/connector keys belong
# to that separate component; no Apify or other scraping-service key is required.
