# Gunakan satu provider; isi key lokal pada file .env.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# OpenRouter: ganti LLM_PROVIDER=openrouter dan LLM_MODEL=openrouter/free.
# Endpoint kompatibel: ganti LLM_PROVIDER=compatible, lalu isi LLM_BASE_URL
# dan LLM_MODEL sesuai endpoint. LLM_BASE_URL tidak menyertakan /chat/completions.
# LLM_BASE_URL=http://127.0.0.1:8000/v1

# Untuk --persist, token login DERAI (24 jam), bukan API key LLM.
DERAI_API_URL=http://api:8000
DERAI_API_TOKEN=
# Berita --persist memakai engine yang mempertahankan ArticleResponse repo acuan.
# Dari container gunakan alamat privat host/jaringan engine, bukan localhost container.
ARTICLE_ENGINE_URL=
SCRAPER_API_KEY=
